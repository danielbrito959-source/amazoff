@page "/produtos"
@page "/produtos/categorias/{CategoryId:int}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject Amazoff.Portal.Services.CurrentUserSession CurrentUserSession
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Produtos</PageTitle>

<section class="dashboard-shell">
    <div class="dashboard-window">
        <aside class="dashboard-sidebar">
            <div class="dashboard-brand">
                <img src="/images/LogoShort_Amazoff.png" alt="Amazoff" class="dashboard-brand__logo" />
            </div>

            <div class="dashboard-nav-group">
                <NavLink class="dashboard-nav-item" href="/dashboard">
                    <span>Dashboard</span>
                </NavLink>
                <NavLink class="dashboard-nav-item" href="/produtos">
                    <span>Produtos</span>
                </NavLink>
            </div>

            <div class="dashboard-nav-group">
                <div class="dashboard-nav-item">
                    <span>Encomendas</span>
                </div>
                <div class="dashboard-nav-item">
                    <span>Clientes</span>
                </div>
                <div class="dashboard-nav-item">
                    <span>Relatorios</span>
                </div>
                <div class="dashboard-nav-item">
                    <span>Marketing</span>
                </div>
                <NavLink class="dashboard-nav-item" href="/recursos-humanos">
                    <span>Recursos Humanos</span>
                </NavLink>
                <LogoutMenuButton />
            </div>
        </aside>

        <div class="dashboard-content">
            <header class="dashboard-topbar">
                <div class="dashboard-topbar__left hr-topbar-actions">
                    @if (CanManageCategories)
                    {
                        <button type="button"
                                class="hr-primary-button"
                                @onclick="HandlePrimaryAction">
                            @PrimaryActionLabel
                        </button>
                    }
                </div>

                <div class="dashboard-topbar__right">
                    <CurrentUserProfile />
                </div>
            </header>

            <main class="dashboard-grid hr-grid">
                <section class="dashboard-panel hr-table-panel">
                    <div class="dashboard-panel__heading">
                        <div>
                            <p class="dashboard-section-tag">@SectionTag</p>
                            <h3>@SectionTitle</h3>
                        </div>

                        @if (IsCategoryDetailView)
                        {
                            <button type="button" class="hr-secondary-button" @onclick="BackToCategories">
                                Voltar às categorias
                            </button>
                        }
                    </div>

                    @if (HasError && !string.IsNullOrWhiteSpace(StatusMessage))
                    {
                        <div class="hr-feedback hr-feedback--error">@StatusMessage</div>
                    }

                    @if (IsLoading)
                    {
                        <p class="dashboard-copy">A carregar categorias...</p>
                    }
                    else if (IsCategoryDetailView && SelectedCategory is null)
                    {
                        <p class="dashboard-copy">A categoria selecionada nao foi encontrada.</p>
                    }
                    else if (!IsCategoryDetailView && Categories.Count == 0)
                    {
                        <p class="dashboard-copy">Nao ha categorias disponiveis.</p>
                    }
                    else if (IsCategoryDetailView)
                    {
                        @if (Models.Count == 0)
                        {
                            <p class="dashboard-copy">Ainda nao existem modelos para a categoria <strong>@SelectedCategory?.Name</strong>.</p>
                        }
                        else
                        {
                            <div class="categories-grid product-models-grid">
                                @foreach (var model in Models)
                                {
                                    <article class="category-card product-model-card">
                                        <div class="category-card__menu-wrap product-model-card__menu-wrap" @onclick:stopPropagation="true">
                                            <button type="button"
                                                    class="category-card__menu-button product-model-card__menu-button"
                                                    @onclick='() => ToggleModelMenu(model.Id)'>
                                                <span class="sr-only">Abrir ações do modelo</span>
                                                <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
                                            </button>

                                            @if (OpenModelMenuId == model.Id)
                                            {
                                                <div class="hr-filter-backdrop" @onclick="CloseModelMenu"></div>
                                                <div class="category-card__menu">
                                                    <button type="button"
                                                            class="category-card__menu-item"
                                                            @onclick='() => OpenEditModelModal(model)'>
                                                        Editar
                                                    </button>
                                                    <button type="button"
                                                            class="category-card__menu-item category-card__menu-item--danger"
                                                            @onclick='() => OpenDeleteModelModal(model)'>
                                                        Eliminar
                                                    </button>
                                                </div>
                                            }
                                        </div>

                                        <img src="@GetModelCardImageUrl(model.ImagePath)"
                                             alt="@model.Name"
                                             class="product-model-card__image" />

                                        <div class="category-card__body product-model-card__body">
                                            <div class="category-card__topline product-model-card__topline">
                                                <p class="category-card__label">Modelo</p>
                                            </div>

                                            <div class="category-card__headline product-model-card__headline">
                                                <h4 class="category-card__title">@model.Name</h4>
                                                <span class="hr-badge @(model.IsActive ? null : "hr-badge--inactive")">
                                                    @(model.IsActive ? "Ativo" : "Inativo")
                                                </span>
                                            </div>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="categories-grid">
                            @foreach (var category in Categories)
                            {
                                <article class="category-card category-card--interactive" @onclick='() => OpenCategory(category.Id)'>
                                    <div class="category-card__body">
                                        <div class="category-card__topline">
                                            <p class="category-card__label">Categoria</p>

                                            <div class="category-card__menu-wrap" @onclick:stopPropagation="true">
                                                <button type="button"
                                                        class="category-card__menu-button"
                                                        @onclick='() => ToggleCategoryMenu(category.Id)'>
                                                    <span class="sr-only">Abrir ações da categoria</span>
                                                    <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
                                                </button>

                                                @if (OpenCategoryMenuId == category.Id)
                                                {
                                                    <div class="hr-filter-backdrop" @onclick="CloseCategoryMenu"></div>
                                                    <div class="category-card__menu">
                                                        <button type="button"
                                                                class="category-card__menu-item"
                                                                @onclick='() => OpenEditModal(category)'>
                                                            Editar
                                                        </button>
                                                        <button type="button"
                                                                class="category-card__menu-item category-card__menu-item--danger"
                                                                @onclick='() => OpenDeleteModal(category)'>
                                                            Eliminar
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="category-card__headline">
                                            <h4 class="category-card__title">@category.Name</h4>
                                            <span class="hr-badge @(category.IsActive ? null : "hr-badge--inactive")">
                                                @(category.IsActive ? "Ativo" : "Inativo")
                                            </span>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>
            </main>
        </div>
    </div>
</section>

@if (IsCreateModalOpen)
{
    <div class="hr-modal-backdrop" @onclick="CloseCreateModal">
        <div class="hr-modal hr-modal--compact" @onclick:stopPropagation="true">
            <div class="hr-modal__header">
                <h3>@(EditingCategoryId.HasValue ? "Editar categoria" : "Adicionar categoria")</h3>
                <button type="button" class="hr-modal__close" @onclick="CloseCreateModal">x</button>
            </div>

            <EditForm Model="CreateCategoryModel" OnValidSubmit="SaveCategoryAsync">
                <DataAnnotationsValidator />

                <div class="hr-modal__grid">
                    <div class="hr-field hr-field--full">
                        <label for="category-name">Nome*</label>
                        <InputText id="category-name" @bind-Value="CreateCategoryModel.Name" />
                        <ValidationMessage For="() => CreateCategoryModel.Name" />
                    </div>

                    <div class="hr-field hr-field--full hr-switch-field">
                        <label for="category-active">Categoria ativa</label>
                        <label class="hr-switch" for="category-active">
                            <InputCheckbox id="category-active" @bind-Value="CreateCategoryModel.IsActive" class="hr-switch__input" />
                            <span class="hr-switch__track" aria-hidden="true"></span>
                        </label>
                    </div>
                </div>

                <div class="hr-modal__actions">
                    <button type="button" class="hr-secondary-button" @onclick="CloseCreateModal">Cancelar</button>
                    <button type="submit" class="hr-primary-button" disabled="@IsBusy">Guardar</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (IsDeleteModalOpen && CategoryPendingDeletion is not null)
{
    <div class="hr-modal-backdrop" @onclick="CloseDeleteModal">
        <div class="hr-modal hr-modal--confirm" @onclick:stopPropagation="true">
            <div class="hr-modal__header">
                <h3>Eliminar categoria</h3>
                <button type="button" class="hr-modal__close" @onclick="CloseDeleteModal">x</button>
            </div>

            <p class="hr-confirm-employee">Tem a certeza que deseja eliminar a categoria <strong>@CategoryPendingDeletion.Name</strong>?</p>

            <div class="hr-modal__actions">
                <button type="button" class="hr-secondary-button" @onclick="CloseDeleteModal">Cancelar</button>
                <button type="button" class="hr-secondary-button hr-secondary-button--danger" @onclick="ConfirmDeleteCategoryAsync" disabled="@IsBusy">Eliminar</button>
            </div>
        </div>
    </div>
}

@if (IsModelModalOpen && SelectedCategory is not null)
{
    <div class="hr-modal-backdrop" @onclick="CloseModelModal">
        <div class="hr-modal" @onclick:stopPropagation="true">
            <div class="hr-modal__header">
                <div>
                    <h3>@ModelModalTitle</h3>
                </div>
                <button type="button" class="hr-modal__close" @onclick="CloseModelModal">x</button>
            </div>

            <EditForm Model="CreateModelModel" OnSubmit="SaveModelAsync">
                <DataAnnotationsValidator />

                <div class="hr-modal__grid">
                    <div class="hr-field hr-field--full hr-field--avatar-simple">
                        <label for="model-photo" class="hr-photo-picker" title="Carregar foto">
                            @if (!string.IsNullOrWhiteSpace(CurrentModelPhotoPreview))
                            {
                                <img src="@CurrentModelPhotoPreview" alt="@CreateModelModel.Name" class="hr-photo-picker__preview" />
                            }
                            else
                            {
                                <div class="hr-photo-picker__fallback">@ModelPhotoFallback</div>
                            }

                            <span class="hr-photo-picker__overlay">
                                <i class="fa-solid fa-camera" aria-hidden="true"></i>
                            </span>
                        </label>
                        <InputFile id="model-photo"
                                   OnChange="UploadModelPhotoAsync"
                                   accept=".png,.jpg,.jpeg"
                                   class="hr-photo-picker__input" />

                        @if (HasModelPhoto)
                        {
                            <button type="button" class="hr-photo-remove-button" @onclick="RemoveModelPhotoSelection">
                                Remover foto
                            </button>
                        }
                    </div>

                    <div class="hr-field hr-field--full">
                        <label for="model-name">Nome*</label>
                        <InputText id="model-name" @bind-Value="CreateModelModel.Name" />
                        <ValidationMessage For="() => CreateModelModel.Name" />
                    </div>

                    <div class="hr-field hr-field--full hr-switch-field">
                        <label for="model-active">Modelo ativo</label>
                        <label class="hr-switch" for="model-active">
                            <InputCheckbox id="model-active" @bind-Value="CreateModelModel.IsActive" class="hr-switch__input" />
                            <span class="hr-switch__track" aria-hidden="true"></span>
                        </label>
                    </div>
                </div>

                <div class="hr-modal__actions">
                    <button type="button" class="hr-secondary-button" @onclick="CloseModelModal">Cancelar</button>
                    <button type="submit" class="hr-primary-button" disabled="@IsBusy">Guardar</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (IsDeleteModelModalOpen && ModelPendingDeletion is not null)
{
    <div class="hr-modal-backdrop" @onclick="CloseDeleteModelModal">
        <div class="hr-modal hr-modal--confirm" @onclick:stopPropagation="true">
            <div class="hr-modal__header">
                <h3>Eliminar modelo</h3>
                <button type="button" class="hr-modal__close" @onclick="CloseDeleteModelModal">x</button>
            </div>

            <p class="hr-confirm-employee">Tem a certeza que deseja eliminar o modelo <strong>@ModelPendingDeletion.Name</strong>?</p>

            <div class="hr-modal__actions">
                <button type="button" class="hr-secondary-button" @onclick="CloseDeleteModelModal">Cancelar</button>
                <button type="button" class="hr-secondary-button hr-secondary-button--danger" @onclick="ConfirmDeleteModelAsync" disabled="@IsBusy">Eliminar</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int? CategoryId { get; set; }

    private readonly List<CategoryViewModel> Categories = [];
    private readonly List<ModelViewModel> Models = [];
    private static readonly HashSet<string> AllowedPhotoExtensions = [".png", ".jpg", ".jpeg"];
    private Amazoff.Portal.Services.CurrentUserDto? CurrentUser { get; set; }
    private CreateCategoryViewModel CreateCategoryModel { get; set; } = new();
    private CreateModelViewModel CreateModelModel { get; set; } = new();
    private CategoryViewModel? CategoryPendingDeletion { get; set; }
    private ModelViewModel? ModelPendingDeletion { get; set; }
    private PendingModelPhotoUpload? PendingModelPhoto { get; set; }
    private int? EditingCategoryId { get; set; }
    private int? OpenCategoryMenuId { get; set; }
    private int? EditingModelId { get; set; }
    private int? OpenModelMenuId { get; set; }
    private bool IsCreateModalOpen { get; set; }
    private bool IsDeleteModalOpen { get; set; }
    private bool IsModelModalOpen { get; set; }
    private bool IsDeleteModelModalOpen { get; set; }
    private bool IsBusy { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool HasError { get; set; }
    private string? StatusMessage { get; set; }
    private bool CanManageCategories => CurrentUser?.RoleId is 1 or 2;
    private bool IsCategoryDetailView => CategoryId.HasValue;
    private CategoryViewModel? SelectedCategory => Categories.FirstOrDefault(category => category.Id == CategoryId);
    private string PrimaryActionLabel => IsCategoryDetailView ? "Adicionar Modelo" : "Adicionar categoria";
    private string SectionTag => IsCategoryDetailView ? "Modelos" : "Categorias";
    private string SectionTitle => IsCategoryDetailView
        ? $"Categoria: {SelectedCategory?.Name ?? "Categoria"}"
        : $"{Categories.Count} categoria(s)";
    private string ModelModalTitle => EditingModelId.HasValue ? "Editar Modelo" : "Adicionar Modelo";
    private bool HasModelPhoto => PendingModelPhoto is not null || !string.IsNullOrWhiteSpace(CreateModelModel.ImagePath);
    private string? CurrentModelPhotoPreview => PendingModelPhoto?.PreviewUrl ?? ResolveImageUrl(CreateModelModel.ImagePath);
    private string ModelPhotoFallback =>
        string.IsNullOrWhiteSpace(CreateModelModel.Name)
            ? "M"
            : char.ToUpperInvariant(CreateModelModel.Name.Trim()[0]).ToString();

    protected override async Task OnParametersSetAsync()
    {
        if (CurrentUser is null)
        {
            CurrentUser = await CurrentUserSession.GetAsync();
        }

        await LoadCategoriesAsync();

        if (IsCategoryDetailView && SelectedCategory is not null)
        {
            await LoadModelsAsync();
        }
        else
        {
            Models.Clear();
        }
    }

    private async Task LoadCategoriesAsync()
    {
        IsLoading = true;

        try
        {
            var categories = await SendApiRequestAsync(async client =>
                await client.GetFromJsonAsync<List<CategoryViewModel>>("/categories"));

            Categories.Clear();

            if (categories is not null)
            {
                Categories.AddRange(categories);
            }

            StatusMessage = null;
            HasError = false;
        }
        catch (Exception)
        {
            Categories.Clear();
            StatusMessage = "Nao foi possivel carregar as categorias.";
            HasError = true;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadModelsAsync()
    {
        if (!CategoryId.HasValue)
        {
            Models.Clear();
            return;
        }

        IsLoading = true;

        try
        {
            var models = await SendApiRequestAsync(async client =>
                await client.GetFromJsonAsync<List<ModelViewModel>>($"/models?categoryId={CategoryId.Value}"));

            Models.Clear();

            if (models is not null)
            {
                Models.AddRange(models);
            }

            StatusMessage = null;
            HasError = false;
        }
        catch (Exception)
        {
            Models.Clear();
            StatusMessage = "Nao foi possivel carregar os modelos.";
            HasError = true;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        EditingCategoryId = null;
        CreateCategoryModel = new CreateCategoryViewModel
        {
            IsActive = true
        };
        IsCreateModalOpen = true;
        OpenCategoryMenuId = null;
        StatusMessage = null;
        HasError = false;
    }

    private void HandlePrimaryAction()
    {
        if (IsCategoryDetailView)
        {
            OpenModelModal();
            return;
        }

        OpenCreateModal();
    }

    private void OpenCategory(int categoryId)
    {
        NavigationManager.NavigateTo($"/produtos/categorias/{categoryId}");
    }

    private void BackToCategories()
    {
        NavigationManager.NavigateTo("/produtos");
    }

    private void OpenModelModal()
    {
        EditingModelId = null;
        CreateModelModel = new CreateModelViewModel
        {
            IsActive = true
        };
        PendingModelPhoto = null;
        IsModelModalOpen = true;
        OpenModelMenuId = null;
        StatusMessage = null;
        HasError = false;
    }

    private void CloseModelModal()
    {
        IsModelModalOpen = false;
        EditingModelId = null;
        PendingModelPhoto = null;
    }

    private void OpenEditModelModal(ModelViewModel model)
    {
        EditingModelId = model.Id;
        CreateModelModel = new CreateModelViewModel
        {
            Name = model.Name,
            ImagePath = model.ImagePath,
            IsActive = model.IsActive
        };
        PendingModelPhoto = null;
        IsModelModalOpen = true;
        OpenModelMenuId = null;
        StatusMessage = null;
        HasError = false;
    }

    private void OpenDeleteModelModal(ModelViewModel model)
    {
        ModelPendingDeletion = model;
        IsDeleteModelModalOpen = true;
        OpenModelMenuId = null;
        StatusMessage = null;
        HasError = false;
    }

    private void CloseDeleteModelModal()
    {
        IsDeleteModelModalOpen = false;
        ModelPendingDeletion = null;
    }

    private void OpenEditModal(CategoryViewModel category)
    {
        EditingCategoryId = category.Id;
        CreateCategoryModel = new CreateCategoryViewModel
        {
            Name = category.Name,
            IsActive = category.IsActive
        };
        IsCreateModalOpen = true;
        OpenCategoryMenuId = null;
        StatusMessage = null;
        HasError = false;
    }

    private void CloseCreateModal()
    {
        IsCreateModalOpen = false;
        EditingCategoryId = null;
    }

    private void OpenDeleteModal(CategoryViewModel category)
    {
        CategoryPendingDeletion = category;
        IsDeleteModalOpen = true;
        OpenCategoryMenuId = null;
        StatusMessage = null;
        HasError = false;
    }

    private void CloseDeleteModal()
    {
        IsDeleteModalOpen = false;
        CategoryPendingDeletion = null;
    }

    private void ToggleCategoryMenu(int categoryId)
    {
        OpenCategoryMenuId = OpenCategoryMenuId == categoryId ? null : categoryId;
    }

    private void CloseCategoryMenu()
    {
        OpenCategoryMenuId = null;
    }

    private void ToggleModelMenu(int modelId)
    {
        OpenModelMenuId = OpenModelMenuId == modelId ? null : modelId;
    }

    private void CloseModelMenu()
    {
        OpenModelMenuId = null;
    }

    private async Task SaveCategoryAsync()
    {
        IsBusy = true;
        StatusMessage = null;
        HasError = false;

        if (string.IsNullOrWhiteSpace(CreateCategoryModel.Name))
        {
            StatusMessage = "O nome da categoria é obrigatório.";
            HasError = true;
            IsBusy = false;
            return;
        }

        try
        {
            HttpResponseMessage response;
            var isEditing = EditingCategoryId.HasValue;

            if (isEditing)
            {
                response = await SendApiRequestAsync(client => client.PutAsJsonAsync($"/categories/{EditingCategoryId}", CreateCategoryModel));
            }
            else
            {
                response = await SendApiRequestAsync(client => client.PostAsJsonAsync("/categories", CreateCategoryModel));
            }

            if (response.IsSuccessStatusCode)
            {
                CloseCreateModal();
                await LoadCategoriesAsync();
                await JS.InvokeVoidAsync(
                    "amazoffToast.success",
                    isEditing ? "Categoria alterada com sucesso." : "Categoria adicionada com sucesso.");
                return;
            }

            var apiMessage = await response.Content.ReadFromJsonAsync<ApiMessageResponse>();
            StatusMessage = apiMessage?.Message ?? (isEditing
                ? "Nao foi possivel alterar a categoria."
                : "Nao foi possivel adicionar a categoria.");
            HasError = true;
        }
        catch (Exception)
        {
            StatusMessage = EditingCategoryId.HasValue
                ? "Nao foi possivel alterar a categoria."
                : "Nao foi possivel adicionar a categoria.";
            HasError = true;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task ConfirmDeleteCategoryAsync()
    {
        if (CategoryPendingDeletion is null)
        {
            return;
        }

        IsBusy = true;
        StatusMessage = null;
        HasError = false;

        try
        {
            var response = await SendApiRequestAsync(client => client.DeleteAsync($"/categories/{CategoryPendingDeletion.Id}"));

            if (response.IsSuccessStatusCode)
            {
                CloseDeleteModal();
                await LoadCategoriesAsync();
                await JS.InvokeVoidAsync("amazoffToast.success", "Categoria eliminada com sucesso.");
                return;
            }

            var apiMessage = await response.Content.ReadFromJsonAsync<ApiMessageResponse>();
            StatusMessage = apiMessage?.Message ?? "Nao foi possivel eliminar a categoria.";
            HasError = true;
        }
        catch (Exception)
        {
            StatusMessage = "Nao foi possivel eliminar a categoria.";
            HasError = true;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task UploadModelPhotoAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;

        if (file is null)
        {
            return;
        }

        var extension = Path.GetExtension(file.Name);

        if (!AllowedPhotoExtensions.Contains(extension))
        {
            StatusMessage = "Formato de imagem invalido. Usa PNG, JPG ou JPEG.";
            HasError = true;
            return;
        }

        StatusMessage = null;
        HasError = false;

        try
        {
            await using var stream = file.OpenReadStream(5_000_000);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            var content = memoryStream.ToArray();
            var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;

            PendingModelPhoto = new PendingModelPhotoUpload(
                file.Name,
                contentType,
                content,
                $"data:{contentType};base64,{Convert.ToBase64String(content)}");
        }
        catch (Exception)
        {
            StatusMessage = "Nao foi possivel preparar a foto do modelo.";
            HasError = true;
        }
    }

    private void RemoveModelPhotoSelection()
    {
        PendingModelPhoto = null;
        CreateModelModel.ImagePath = null;
        StatusMessage = null;
        HasError = false;
    }

    private async Task SaveModelAsync()
    {
        IsBusy = true;
        StatusMessage = null;
        HasError = false;

        if (string.IsNullOrWhiteSpace(CreateModelModel.Name))
        {
            StatusMessage = "O nome do modelo e obrigatorio.";
            HasError = true;
            IsBusy = false;
            return;
        }

        if (!CategoryId.HasValue)
        {
            StatusMessage = "A categoria do modelo nao foi encontrada.";
            HasError = true;
            IsBusy = false;
            return;
        }

        try
        {
            var isEditing = EditingModelId.HasValue;
            var request = new CreateOrUpdateModelRequest
            {
                Name = CreateModelModel.Name.Trim(),
                CategoryId = CategoryId.Value,
                ImagePath = CreateModelModel.ImagePath,
                IsActive = CreateModelModel.IsActive
            };

            var response = isEditing
                ? await SendApiRequestAsync(client => client.PutAsJsonAsync($"/models/{EditingModelId}", request))
                : await SendApiRequestAsync(client => client.PostAsJsonAsync("/models", request));

            if (!response.IsSuccessStatusCode)
            {
                var apiMessage = await response.Content.ReadFromJsonAsync<ApiMessageResponse>();
                StatusMessage = apiMessage?.Message ?? (isEditing
                    ? "Nao foi possivel alterar o modelo."
                    : "Nao foi possivel adicionar o modelo.");
                HasError = true;
                return;
            }

            var createdModel = await response.Content.ReadFromJsonAsync<ModelViewModel>();

            if (createdModel is null)
            {
                StatusMessage = "O modelo foi criado, mas a resposta da API veio vazia.";
                HasError = true;
                return;
            }

            if (PendingModelPhoto is not null)
            {
                var uploaded = await SavePendingModelPhotoAsync(createdModel.Id, PendingModelPhoto);

                if (!uploaded)
                {
                    return;
                }
            }

            CloseModelModal();
            await LoadModelsAsync();
            await JS.InvokeVoidAsync(
                "amazoffToast.success",
                isEditing ? "Modelo alterado com sucesso." : "Modelo adicionado com sucesso.");
        }
        catch (Exception)
        {
            StatusMessage = EditingModelId.HasValue
                ? "Nao foi possivel alterar o modelo."
                : "Nao foi possivel adicionar o modelo.";
            HasError = true;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task ConfirmDeleteModelAsync()
    {
        if (ModelPendingDeletion is null)
        {
            return;
        }

        IsBusy = true;
        StatusMessage = null;
        HasError = false;

        try
        {
            var response = await SendApiRequestAsync(client => client.DeleteAsync($"/models/{ModelPendingDeletion.Id}"));

            if (response.IsSuccessStatusCode)
            {
                CloseDeleteModelModal();
                await LoadModelsAsync();
                await JS.InvokeVoidAsync("amazoffToast.success", "Modelo eliminado com sucesso.");
                return;
            }

            var apiMessage = await response.Content.ReadFromJsonAsync<ApiMessageResponse>();
            StatusMessage = apiMessage?.Message ?? "Nao foi possivel eliminar o modelo.";
            HasError = true;
        }
        catch (Exception)
        {
            StatusMessage = "Nao foi possivel eliminar o modelo.";
            HasError = true;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task<T> SendApiRequestAsync<T>(Func<HttpClient, Task<T>> request)
    {
        var client = HttpClientFactory.CreateClient("AmazoffApi");
        return await request(client);
    }

    private async Task<bool> SavePendingModelPhotoAsync(int modelId, PendingModelPhotoUpload pendingPhoto)
    {
        try
        {
            using var formData = new MultipartFormDataContent();
            using var fileContent = new ByteArrayContent(pendingPhoto.Content);
            fileContent.Headers.ContentType = new(pendingPhoto.ContentType);
            formData.Add(fileContent, "file", pendingPhoto.FileName);

            var response = await SendApiRequestAsync(client => client.PostAsync($"/models/{modelId}/photo", formData));

            if (!response.IsSuccessStatusCode)
            {
                var apiMessage = await response.Content.ReadFromJsonAsync<ApiMessageResponse>();
                StatusMessage = apiMessage?.Message ?? "Nao foi possivel guardar a foto do modelo.";
                HasError = true;
                return false;
            }

            var uploadResult = await response.Content.ReadFromJsonAsync<ModelPhotoUploadResponse>();

            if (uploadResult is not null)
            {
                CreateModelModel.ImagePath = uploadResult.ImagePath;
            }

            return true;
        }
        catch (Exception)
        {
            StatusMessage = "Nao foi possivel guardar a foto do modelo.";
            HasError = true;
            return false;
        }
    }

    private string? ResolveImageUrl(string? imagePath)
    {
        if (string.IsNullOrWhiteSpace(imagePath))
        {
            return null;
        }

        if (Uri.TryCreate(imagePath, UriKind.Absolute, out _))
        {
            return imagePath;
        }

        var client = HttpClientFactory.CreateClient("AmazoffApi");
        var baseUrl = client.BaseAddress?.ToString().TrimEnd('/');

        return string.IsNullOrWhiteSpace(baseUrl)
            ? imagePath
            : $"{baseUrl}/{imagePath.TrimStart('/')}";
    }

    private string GetModelCardImageUrl(string? imagePath)
    {
        return ResolveImageUrl(imagePath) ?? "/images/LogoShort_Amazoff.png";
    }

